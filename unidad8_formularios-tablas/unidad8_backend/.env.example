# ==============================================================================
# Configuración de Variables de Entorno — Food Store API (Unidad 8)
# [Configuración de Base de Datos y Persistencia]
# ==============================================================================
# NOTA: La variable DATABASE_URL es obligatoria; app/database.py no aplica fallbacks silenciosos.
# El nombre de la base de datos PostgreSQL (por ejemplo tp7_server_state) es una convención
# local y no depende del número de TP ni afecta la compatibilidad.

# Opción A — PostgreSQL (Entorno principal de desarrollo y persistencia relacional):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tp7_server_state

# Opción B — SQLite con persistencia en disco (Configuración explícita local / dev.db):
# DATABASE_URL=sqlite:///./dev.db

# Opción C — SQLite en memoria (Pruebas volátiles en RAM / testing aislado):
# DATABASE_URL=sqlite:///:memory:
