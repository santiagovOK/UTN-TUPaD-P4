            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mouse Invalido\",\n  \"precio\": -100,\n  \"stock\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos/",
              "host": ["{{baseUrl}}"],
              "path": ["productos", ""]
            }
          }
        },
