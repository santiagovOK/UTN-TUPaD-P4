              "raw": "{\n  \"nombre\": \"Teclado Mecánico RGB Pro\",\n  \"categoria\": \"Periféricos\",\n  \"precio\": 48999.00,\n  \"stock\": 8,\n  \"stock_minimo\": 5,\n  \"activo\": true\n}"
