      "item": [
        {
          "name": "1. Listar Productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/?skip=0&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["productos", ""],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "2. Crear Producto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Teclado Mecánico RGB\",\n  \"categoria\": \"Periféricos\",\n  \"precio\": 45000.50,\n  \"stock\": 12,\n  \"stock_minimo\": 5,\n  \"activo\": true\n}"
