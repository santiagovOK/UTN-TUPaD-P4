{
  "name": "tp5-react-postgresql",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:back": ".venv/bin/uvicorn --app-dir src app.main:app --reload --port 8000 || uvicorn --app-dir src app.main:app --reload --port 8000",
    "dev:all": "concurrently -k -n \"front,back\" -c \"cyan,green\" \"pnpm dev\" \"pnpm dev:back\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
