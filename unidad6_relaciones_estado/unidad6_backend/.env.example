# Configuración de Base de Datos (SQLModel / SQLAlchemy)
# Copie este archivo a .env y configure la opción deseada:

# Opción A: PostgreSQL (Entorno principal de entrega)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tp6_relaciones

# Opción B: SQLite como Fallback local (Pruebas y desarrollo rápido sin PostgreSQL)
# DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=sqlite:///:memory:
