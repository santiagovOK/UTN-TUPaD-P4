# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (FastAPI / SQLModel / SQLAlchemy)
# Copie este archivo a .env y descomente UNA sola opción:
# ==============================================================================

# ------------------------------------------------------------------------------
# OPCIÓN 1: PostgreSQL (Entorno principal de entrega y evaluación)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tp6_relaciones

# ------------------------------------------------------------------------------
# OPCIÓN 2: SQLite con persistencia en disco (Fallback local)
# Guarda los datos en unidad6_backend/dev.db para inspección visual.
# ------------------------------------------------------------------------------
# DATABASE_URL=sqlite:///./dev.db

# ------------------------------------------------------------------------------
# OPCIÓN 3: SQLite en memoria (Pruebas volátiles en RAM sin ensuciar disco)
# 100% en memoria (StaticPool). No genera archivos .db y se reinicia en cada arranque.
# ------------------------------------------------------------------------------
# DATABASE_URL=sqlite:///:memory:
